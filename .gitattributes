# Normalise line endings so a Windows checkout never shows every file as
# modified. Text files are stored with LF in the repository regardless of the
# machine that committed them.
* text=auto eol=lf

# Never touch binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.webm binary
